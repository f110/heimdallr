load("//:RELEASE.bzl", "VERSION")

exports_files(
    [
        "webhook_ca.crt",
        "webhook_ca.key",
    ],
    visibility = ["//visibility:public"],
)

sh_binary(
    name = "run",
    srcs = ["//cmd/heimdev"],
    args = [
        "cluster",
        "run-operator",
        "--kind=$(location @kind//:file)",
        "--manifest=$(location //operator/deploy/dev:all-in-one)",
        "--controller-image=$(location //container:operator)",
        "--sidecar-image=$(location //container:sidecar)",
    ],
    data = [
        "//container:operator",
        "//container:sidecar",
        "//operator/deploy/dev:all-in-one",
        "@kind//:file",
    ],
)

sh_binary(
    name = "load",
    srcs = ["//cmd/heimdev"],
    args = [
        "cluster",
        "load",
        "--kind=$(location @kind//:file)",
        "--images=ghcr.io/f110/heimdallr/discovery-sidecar:" + VERSION + "=$(location //container:sidecar)",
    ],
    data = [
        "//container:sidecar",
        "@kind//:file",
    ],
)

sh_binary(
    name = "log",
    srcs = ["//cmd/heimdev"],
    args = [
        "cluster",
        "log-operator",
        "--kind=$(location @kind//:file)",
    ],
    data = [
        "@kind//:file",
    ],
)
