load("@rules_go//go:def.bzl", "go_test")
load("//:RELEASE.bzl", "VERSION")

K8S_CLUSTER_VERSION = "v1.32.0"

go_test(
    name = "test_test",
    timeout = "eternal",
    srcs = [
        "etcd-controller_test.go",
        "main_test.go",
        "proxy-controller_test.go",
    ],
    args = [
        "-test.v=true",
        "-crd=$(location //operator/config/crd:crd)",
        "-cluster-version=" + K8S_CLUSTER_VERSION,
        "-kind-file=$(location @kind//:file)",
        "-proxy-image=container/proxy",
        "-rpc-image=container/rpcserver",
        "-dashboard-image=container/dashboard",
        "-operator-image=container/operator",
        "-sidecar-image=container/sidecar",
        "-all-in-one-manifest=$(location //operator/deploy/e2e:all-in-one)",
        "-build-version=" + VERSION,
    ],
    data = [
        "//container:dashboard",
        "//container:operator",
        "//container:proxy",
        "//container:rpcserver",
        "//container:sidecar",
        "//operator/config/crd",
        "//operator/deploy/e2e:all-in-one",
        "@kind//:file",
    ],
    rundir = ".",
    # The sandbox stages the OCI layout as a tree of symlinks and go-containerregistry refuses to
    # read a blob that is a symlink.
    tags = [
        "e2e",
        "no-sandbox",
    ],
    deps = [
        "//operator/e2e/e2eutil",
        "//operator/e2e/framework",
        "//pkg/config/configv2",
        "//pkg/k8s",
        "//pkg/k8s/api/etcd",
        "//pkg/k8s/api/etcdv1alpha2",
        "//pkg/k8s/controllers",
        "//pkg/k8s/k8sfactory",
        "//pkg/k8s/kind",
        "//pkg/k8s/registry",
        "//pkg/logger",
        "//pkg/testing/btesting",
        "@io_etcd_go_etcd_client_v3//:client",
        "@io_k8s_apimachinery//pkg/apis/meta/v1:meta",
        "@io_k8s_client_go//rest",
    ],
)
