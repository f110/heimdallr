common --enable_bzlmod
common --incompatible_enable_proto_toolchain_resolution

build --cxxopt=-std=c++17 --host_cxxopt=-std=c++17
build --@protobuf//bazel/toolchains:prefer_prebuilt_protoc

test --test_output=errors --test_tag_filters=-e2e,-e2e-fault

test:ci --test_output=errors
test:ci --test_tag_filters=-e2e,-e2e-fault
test:ci --test_sharding_strategy=disabled

test:e2e --test_tag_filters=e2e --test_output=streamed
test:e2e-fault --test_tag_filters=e2e,e2e-fault --test_output=streamed
