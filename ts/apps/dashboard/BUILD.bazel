load("@aspect_rules_js//js:defs.bzl", "js_run_binary")
load("@aspect_rules_ts//ts:defs.bzl", "ts_config", "ts_project")
load("@npm//:defs.bzl", "npm_link_all_packages")
load("@npm//ts/apps/dashboard:vite/package_json.bzl", "bin")

SRC_PATTERNS = [
    "**/*.tsx",
    "**/*.ts",
]

TEST_PATTERNS = [
    "*.test.tsx",
    "*.test.ts",
]

ASSET_PATTERNS = [
    "index.html",
    "src/*.css",
]

GENERATED_PACKAGES = ["//ts/apps/dashboard/src/connect"]

NPM_DEPS = [
    "//ts/apps/dashboard:node_modules/@bufbuild/protobuf",
    "//ts/apps/dashboard:node_modules/@connectrpc/connect",
    "//ts/apps/dashboard:node_modules/@connectrpc/connect-query",
    "//ts/apps/dashboard:node_modules/@connectrpc/connect-web",
    "//ts/apps/dashboard:node_modules/@mantine/core",
    "//ts/apps/dashboard:node_modules/@mantine/form",
    "//ts/apps/dashboard:node_modules/@mantine/hooks",
    "//ts/apps/dashboard:node_modules/@tanstack/react-query",
    "//ts/apps/dashboard:node_modules/@tanstack/react-router",
    "//ts/apps/dashboard:node_modules/@tanstack/router-plugin",
    "//ts/apps/dashboard:node_modules/@types/node",
    "//ts/apps/dashboard:node_modules/@types/react",
    "//ts/apps/dashboard:node_modules/@types/react-dom",
    "//ts/apps/dashboard:node_modules/@vitejs/plugin-react",
    "//ts/apps/dashboard:node_modules/dayjs",
    "//ts/apps/dashboard:node_modules/react",
    "//ts/apps/dashboard:node_modules/react-dom",
    "//ts/apps/dashboard:node_modules/vite",
]

npm_link_all_packages()

ts_config(
    name = "tsconfig",
    src = "tsconfig.json",
    visibility = ["//ts/apps/dashboard:__subpackages__"],
    deps = [
        "tsconfig.app.json",
        "tsconfig.node.json",
    ],
)

bin.vite_binary(
    name = "vite",
    chdir = package_name(),
    data = ["vite.config.ts"],
)

js_run_binary(
    name = "vite_build",
    srcs = glob(
        include = SRC_PATTERNS + ASSET_PATTERNS,
        allow_empty = True,
        exclude = TEST_PATTERNS,
    ) + GENERATED_PACKAGES + NPM_DEPS,
    args = ["build"],
    chdir = package_name(),
    out_dirs = ["dist"],
    tool = ":vite",
    visibility = ["//visibility:public"],
)

# vite builds through esbuild and never checks the types, so the type check is a separate target.
ts_project(
    name = "typecheck_app",
    srcs = glob(
        include = [
            "src/**/*.ts",
            "src/**/*.tsx",
        ],
        exclude = TEST_PATTERNS,
    ),
    no_emit = True,
    resolve_json_module = True,
    ts_build_info_file = "node_modules/.tmp/tsconfig.app.tsbuildinfo",
    tsconfig = "tsconfig.app.json",
    deps = GENERATED_PACKAGES + NPM_DEPS,
)

ts_project(
    name = "typecheck_node",
    srcs = ["vite.config.ts"],
    no_emit = True,
    resolve_json_module = True,
    ts_build_info_file = "node_modules/.tmp/tsconfig.node.tsbuildinfo",
    tsconfig = "tsconfig.node.json",
    deps = [
        "//ts/apps/dashboard:node_modules/@tanstack/router-plugin",
        "//ts/apps/dashboard:node_modules/@types/node",
        "//ts/apps/dashboard:node_modules/@vitejs/plugin-react",
        "//ts/apps/dashboard:node_modules/vite",
    ],
)

filegroup(
    name = "typecheck",
    srcs = [
        ":typecheck_app_typecheck",
        ":typecheck_node_typecheck",
    ],
)
